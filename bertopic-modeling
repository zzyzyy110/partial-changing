# ---------------------- 2. 文本预处理函数（适配LLM论文） ----------------------
def preprocess_combined_text(title, abstract):
    # 合并论文标题+摘要，保留标记区分文本结构
    combined_text = f"[TITLE] {str(title).strip()} [ABSTRACT] {str(abstract).strip()}"
    # 统一小写
    combined_text = combined_text.lower()
    # 仅保留英文字母、空格、标记符号，过滤标点、数字、特殊符号
    combined_text = re.sub(r'[^a-zA-Z\s\[\]]', '', combined_text)
    # 分词过滤无效词汇
    words = combined_text.split()
    words = [word for word in words if len(word) >= 3]  # 过滤2字母及以下短词
    words = [word for word in words if word not in custom_stop_words]  # 过滤停用词
    words = [word for word in words if word not in ["[Article Title]", "[Abstract]"]]  # 去除结构标记
    return ' '.join(words) if words else ''

# ---------------------- 3. 数据加载与预处理（适配savedrecs.csv + Article Title/Abstract列） ----------------------
np.random.seed(42)  # 固定随机种子，结果完全可复现
# 适配用户指定的CSV文件名：savedrecs.csv，可根据实际路径调整
csv_file_path = "C:/Users/liuqian/Desktop/AI for electrolyte-review/摘要-0828.csv"
embedding_save_path = "llm_embeddings_768d.npy"  # 768维高精度向量缓存，避免重复计算

try:
    # 读取CSV文件
    df = pd.read_csv(csv_file_path, encoding='gbk')
    # 适配用户指定的列名：Article Title、Abstract
    required_columns = ["Article Title", "Abstract"]
    if not all(col in df.columns for col in required_columns):
        raise ValueError(f"CSV缺少必要列！需包含 {required_columns}，当前列：{df.columns.tolist()}")

    # 过滤标题、摘要全为空的无效行
    df_valid = df.dropna(subset=["Article Title", "Abstract"], how="all").reset_index(drop=True)
    print(f"原始LLM论文数据共 {len(df)} 行，过滤空行后剩余 {len(df_valid)} 行")

    # 批量预处理文本
    print("正在合并论文标题与摘要，执行LLM文本预处理...")
    df_valid["combined_text"] = df_valid.apply(
        lambda row: preprocess_combined_text(row["Article Title"], row["Abstract"]), axis=1
    )

    # 过滤预处理后过短的无效文本
    df_valid = df_valid[df_valid["combined_text"].str.len() > 30].reset_index(drop=True)
    combined_texts = df_valid["combined_text"].tolist()
    print(f"预处理完成，有效LLM论文数据共 {len(combined_texts)} 条")

    if len(combined_texts) == 0:
        print("错误：无有效论文数据！")
        exit(1)
    print(f"预处理文本示例（第1条，前150字符）：\n{combined_texts[0][:150]}...")

except FileNotFoundError:
    print(f"错误：找不到文件 {csv_file_path}，请检查文件路径是否正确")
    exit(1)
except ValueError as ve:
    print(f"数据格式错误：{str(ve)}")
    exit(1)
except Exception as e:
