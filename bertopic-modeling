    exit(1)

# ---------------------- 4. 嵌入向量生成（all-mpnet-base-v2 768维高精度模型） ----------------------
try:
    embeddings = None
    # 加载本地缓存向量，避免重复计算
    if os.path.exists(embedding_save_path):
        print(f"加载本地768维LLM论文向量：{embedding_save_path}")
        embeddings = np.load(embedding_save_path)
        # 校验向量数量与文本匹配，不匹配则重新生成
        if embeddings.shape[0] != len(combined_texts):
            print("向量数量与论文数量不匹配，重新生成向量...")
            embeddings = None

    if embeddings is None:
        print("加载高精度模型 all-mpnet-base-v2（768维语义向量）...")
        embedding_model = SentenceTransformer('all-mpnet-base-v2')

        print("批量生成LLM论文语义向量...")
        embeddings = embedding_model.encode(
            combined_texts,
            show_progress_bar=True,
            convert_to_numpy=True
        )
        # 保存向量到本地缓存
        np.save(embedding_save_path, embeddings)
        print(f"768维论文向量已保存至：{embedding_save_path}")

    print(f"最终向量矩阵形状：{embeddings.shape} （论文数, 768维）")

except Exception as e:
    print(f"模型加载/向量生成错误：{str(e)}")
    exit(1)

# ---------------------- 5. 原生BERTopic聚类（HDBSCAN自动聚类，无KMeans） ----------------------
# UMAP降维参数（适配论文长文本语义）
umap_params = {
    "n_components": 5,
    "n_neighbors": 10,
    "min_dist": 0.08,
    "random_state": 42
}
umap_model = UMAP(**umap_params)

# 原生BERTopic配置：自动识别最优主题数，适配LLM论文聚类
topic_model = BERTopic(
    embedding_model=None,        # 使用预生成向量，不重复编码
    umap_model=umap_model,
    min_topic_size=12,            # 单个主题最少论文数量，避免无效小聚类
    verbose=True,
    top_n_words=5,                # 每个主题展示核心关键词数量
    n_gram_range=(1, 3),          # 支持1-3字词组合关键词（适配专业术语）
    calculate_probabilities=True  # 计算每篇论文所属主题概率
)

print("开始训练原生BERTopic模型（LLM论文自动语义聚类）...")
topics, probabilities = topic_model.fit_transform(combined_texts, embeddings)

# ---------------------- 6. 输出聚类主题结果与核心关键词 ----------------------
topic_info = topic_model.get_topic_info()
print("\n===== LLM论文主题聚类结果汇总 =====")
print(topic_info[["Topic", "Count", "Name"]].to_string(index=False))

print("\n===== 各主题核心关键词 & 权重 =====")
for topic_id in topic_info["Topic"].tolist():
    if topic_id != -1:  # 过滤噪声主题
        topic_count = topic_info[topic_info["Topic"] == topic_id]["Count"].iloc[0]
        print(f"\n主题 #{topic_id}（包含{topic_count}篇LLM论文）:")
        # 过滤低权重无效关键词
        topic_words = [(word, score) for word, score in topic_model.get_topic(topic_id) if score > 0.01]
        for word, score in topic_words[:8]:
            print(f"  {word}: {score:.4f}")

# ====================== 聚类质量评估（无gensim，向量余弦距离法） ======================
print("\n===== 聚类质量量化评估（基于语义向量余弦距离） =====")
# 1. 计算每个主题中心向量
topic_center_dict = {}
valid_topic_ids = [tid for tid in topic_info["Topic"] if tid != -1]
for tid in valid_topic_ids:
    # 获取当前主题所有论文下标
    paper_index = [idx for idx, t_id in enumerate(topics) if t_id == tid]
    # 主题中心 = 该主题所有向量均值
    center_vec = embeddings[paper_index].mean(axis=0)
    topic_center_dict[tid] = center_vec

# 2. 计算【主题内部平均余弦距离】：数值越小，同一主题论文越紧凑
inner_distance_list = []
for tid, center in topic_center_dict.items():
    paper_index = [idx for idx, t_id in enumerate(topics) if t_id == tid]
    dist_matrix = cosine_distances(embeddings[paper_index], center.reshape(1, -1))
    avg_inner_dist = dist_matrix.mean()
    inner_distance_list.append(avg_inner_dist)
    print(f"主题{tid} 内部平均余弦距离：{avg_inner_dist:.4f}")

avg_all_inner = np.mean(inner_distance_list)
print(f"\n全部主题平均内部距离（越小聚类越紧凑）：{avg_all_inner:.4f}")

# 3. 计算【主题之间平均余弦距离】：数值越大，不同主题区分越清晰
center_array = np.array(list(topic_center_dict.values()))
inter_dist_matrix = cosine_distances(center_array)
# 取出上三角，排除自身距离
upper_triangle = inter_dist_matrix[np.triu_indices_from(inter_dist_matrix, k=1)]
avg_all_inter = upper_triangle.mean()
print(f"主题间平均余弦距离（越大区分度越高）：{avg_all_inter:.4f}")

# 4. 综合区分得分 inter / inner，调参对比核心指标，越高越好
separation_score = avg_all_inter / avg_all_inner
print(f"综合聚类区分得分 inter/inner（越高聚类效果越好）：{separation_score:.4f}")

